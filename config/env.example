# LineMod API
LINEMOD_API_KEY=sr-gl-xxxxxxxx
LINEMOD_MODEL=deepseek-v4-flash
LINEMOD_URL=https://api.linemod.ai/v1/chat/completions
LINEMOD_REQUEST_GAP=0.5
LINEMOD_MAX_ATTEMPTS=6
LINEMOD_TIMEOUT=60

# Sampling
SAMPLE_SEED=42

# Optional: path to legacy DemoTest for bridging old manifests
# LEGACY_DEMOTEST_ROOT=D:\KMG\Coding\DemoTest

# Gated datasets (set to 0/false to skip when access missing)
ENABLE_WILDGUARD=0
ENABLE_WMDP=0
